{
  "name": "tesle-platform",
  "private": true,
  "version": "1.0.0",
  "description": "The AI-native operating system for African businesses. Unified ERP, CRM, HRM, Financials, Analytics, and more.",
  "author": "Tesle",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "products/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/website",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:portal": "npm run dev --workspace=apps/portal",
    "dev:workspace": "npm run dev --workspace=apps/workspace",
    "build": "npm run build --workspace=apps/website",
    "build:all": "npm run build --workspaces --if-present",
    "build:pkgs": "npm run build --workspace=packages/ui --workspace=packages/auth --workspace=packages/permissions --workspace=packages/database --workspace=packages/sdk",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf apps/*/dist apps/*/node_modules packages/*/dist packages/*/node_modules products/*/dist products/*/node_modules node_modules"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
