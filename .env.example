# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tesle_admin
POSTGRES_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. In production, set your actual domains:
# CORS_ORIGIN=https://tesle.com,https://admin.tesle.com,https://portal.tesle.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Password Hashing ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── OpenAI (AI features) ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
AI_TEMPERATURE=0.7

# ── Document Storage ──────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=./storage/documents

# ── Redis (caching, rate limiting) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
