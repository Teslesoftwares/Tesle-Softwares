FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/website/package.json ./apps/website/
COPY apps/admin/package.json ./apps/admin/
COPY apps/portal/package.json ./apps/portal/
COPY packages/ui/package.json ./packages/ui/
COPY products/*/package.json ./products/

RUN npm install

COPY . .

RUN npm run build --workspace=apps/website
RUN npm run build --workspace=apps/admin
RUN npm run build --workspace=apps/portal

FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/nginx.conf

COPY --from=build /app/apps/website/dist /usr/share/nginx/html/website
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html/admin
COPY --from=build /app/apps/portal/dist /usr/share/nginx/html/portal

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
